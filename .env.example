# Puerto de la API (usa 4100)
PORT=4100

# Cadena de conexion a PostgreSQL
DATABASE_URL=postgres://beka_user:cambiar_password_segura_123@localhost:55432/beka

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
AUTH_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# WhatsApp
WHATSAPP_ENABLED=true
WHATSAPP_SESION_DIR=/app/data/whatsapp

# Frontend compilado (lo sirve la API)
FRONTEND_DIST=/app/frontend-dist

# Navegador para WhatsApp (en el contenedor de puppeteer)
CHROME_EXECUTABLE=/usr/bin/google-chrome

# Nombre del negocio
NOMBRE_NEGOCIO=BEKA

# Credenciales del sistema NICE (opcional, para sincronizar catalogo)
NICE_USER=
NICE_PASS=
NICE_URL_LOGIN=
